<?xml version="1.0" encoding="UTF-8" ?>
<SqlClass name="ExecuteQueryData" package="org.openbravo.erpCommon.utility" >
  <SqlClassComment></SqlClassComment>
  <SqlMethod name="isParamTab" type="preparedStatement" return="string">
    <SqlMethodComment></SqlMethodComment>
    <Sql>
    <![CDATA[
      SELECT t.isdefaultacct as isParamTab from ad_table t, ad_tab tb where t.ad_table_id=tb.ad_table_id and tb.ad_tab_id=?
    ]]></Sql>
    <Parameter name="tableId"/>
  </SqlMethod>
  <SqlMethod name="initParamtab" type="preparedStatement" return="string" connection="true">
    <SqlMethodComment></SqlMethodComment>
    <Sql>
    <![CDATA[
      select ad_initparamtab() from dual;
    ]]></Sql>
  </SqlMethod>
  <SqlMethod name="insertFilterParameter" type="preparedStatement" return="rowCount" connection="true">
    <SqlMethodComment></SqlMethodComment>
    <Sql>
    <![CDATA[
      insert into ad_tempfilters(columname,filtervalue) values (?,?)
    ]]></Sql>
    <Parameter name="columnname"/>
    <Parameter name="filtervalue"/>
  </SqlMethod> 
</SqlClass>