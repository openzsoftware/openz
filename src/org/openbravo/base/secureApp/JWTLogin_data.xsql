<SqlClass name="JWTLoginData" package="org.openbravo.base.secureApp" accessModifier="public">
   <SqlClassComment></SqlClassComment>
   <SqlMethod name="dummy" type="preparedStatement" return="multiple">
      <SqlMethodComment></SqlMethodComment>
      <Sql><![CDATA[
        SELECT '' as publickey,
               '' as iss,
               '' as aud
        FROM dual
      ]]></Sql>
   </SqlMethod>
   <SqlMethod name="apiActive" type="preparedStatement" return="String">
      <SqlMethodComment></SqlMethodComment>
      <Sql><![CDATA[
          select case when count(*)>0 then 'Y' else 'N' end as retval from zse_shop where api = 'JWT' and isactive = 'Y' and coalesce(publickey,'') != ''
      ]]></Sql>
   </SqlMethod>
   <SqlMethod name="getPublicKeys" type="preparedStatement" return="multiple">
      <SqlMethodComment></SqlMethodComment>
      <Sql><![CDATA[
        SELECT publickey,
               jwt_issuer as iss,
               jwt_audience as aud
               from zse_shop where api = 'JWT' and isactive = 'Y' and coalesce(publickey,'') != ''
      ]]></Sql>
   </SqlMethod>
   <SqlMethod name="getUserId" type="preparedStatement" return="String">
      <SqlMethodComment></SqlMethodComment>
      <Sql><![CDATA[
        SELECT ad_user_id from ad_user where username = ? and isactive = 'Y'
      ]]></Sql>
      <Parameter name="username"/>
   </SqlMethod>
</SqlClass>
